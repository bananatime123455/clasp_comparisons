Bootstrap: docker
From: nvcr.io/nvidia/clara/monai-toolkit:3.0

%files
    "models/UNIT_pix2pixHD" /opt/imaginaire_src

%post
    export DEBIAN_FRONTEND=noninteractive

    echo "Installing system-level dependencies..."
    apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
        git \
        wget \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

    echo "Installing additional Python packages..."
    pip install --upgrade pip

    # The base image ships an NGC-patched torch build that only supports
    # up to sm_90 (Hopper). Blackwell GPUs (RTX 50-series, sm_120) are NOT
    # supported by that build. Replace it with a torch build that includes
    # sm_120 kernels.
    pip uninstall -y torch torchvision torchaudio || true
    pip install --no-cache-dir \
        torch==2.10.0+cu128 \
        torchvision==0.25.0+cu128 \
        torchaudio==2.10.0+cu128 \
        --index-url https://download.pytorch.org/whl/cu128

    # --- Compiler pin for nvcc ------------------------------------------
    # nvcc (CUDA 12.6 in this image) refuses to compile against GCC >13.
    # Pin explicitly to the system g++ (11.4.0, confirmed compatible)
    # rather than relying on PATH resolution or a nonexistent gcc-12.
    export CC=/usr/bin/gcc
    export CXX=/usr/bin/g++
    export NVCC_PREPEND_FLAGS='-ccbin /usr/bin/g++'

    echo "Building imaginaire's custom CUDA extensions from local source..."
    # NOTE: these extensions' setup.py files hardcode
    #   -gencode arch=compute_70,code=sm_70
    #   -gencode arch=compute_75,code=sm_75
    #   -gencode arch=compute_80,code=sm_80
    # with NO sm_120 (Blackwell) target. TORCH_CUDA_ARCH_LIST has no effect
    # here since the gencode list is hardcoded in source, not read from env.
    # On a Blackwell GPU these compiled kernels will NOT run and will need
    # each setup.py's gencode list patched to add:
    #   -gencode arch=compute_120,code=sm_120
    # before this produces a truly working build for that hardware.
    for p in correlation channelnorm resample2d bias_act upfirdn2d; do
        echo "Building ${p}..."
        cd "/opt/imaginaire_src/imaginaire/third_party/${p}"
        rm -rf build dist *.egg-info
        pip install --no-build-isolation . \
            || echo "WARNING: build failed for ${p}"
    done

    echo "Verifying custom extensions..."
    python -c "import correlation_cuda; print('correlation_cuda OK')" || echo "WARNING: correlation_cuda import failed"
    python -c "import channelnorm_cuda; print('channelnorm_cuda OK')" || echo "WARNING: channelnorm_cuda import failed"
    python -c "import resample2d_cuda; print('resample2d_cuda OK')" || echo "WARNING: resample2d_cuda import failed"
    python -c "import bias_act_cuda; print('bias_act_cuda OK')" || echo "WARNING: bias_act_cuda import failed"
    python -c "import upfirdn2d_cuda; print('upfirdn2d_cuda OK')" || echo "WARNING: upfirdn2d_cuda import failed"

    # --- OpenCV cleanup / pinned reinstall -------------------------------
    # The base image ships a compiled cv2 package that also contains a
    # version-specific native module (cv2/python-3.10/cv2.cpython-310-...so)
    # bundled alongside the version-agnostic cv2.abi3.so. This subfolder is
    # NOT part of any pip-installed opencv wheel (confirmed by inspecting
    # opencv-python-headless's own file list) and is NOT tracked by pip, so
    # `pip uninstall`, `--force-reinstall`, and partial `rm -rf` of only
    # that subfolder all fail to remove it -- cv2/__init__.py's bootstrap()
    # preferentially loads it over the fresh wheel's own .so, leaving
    # cv2.dnn present but missing DictValue (or, if only the subfolder
    # is deleted without removing the rest of the tree cleanly, causing an
    # import recursion error instead). The only fix that has been verified
    # to actually work is a full removal of the entire cv2/ directory
    # before reinstalling, so nothing from the base image's build survives
    # into the fresh install.
    pip uninstall -y opencv opencv-python opencv-python-headless opencv-contrib-python || true
    rm -rf /usr/local/lib/python3.10/dist-packages/cv2
    find /usr/local/lib/python3.10/dist-packages -maxdepth 1 -iname "*opencv*" -exec rm -rf {} + || true

    pip install --no-cache-dir --no-deps "opencv-python-headless==4.9.0.80"

    python3 -c "import cv2, os; print('cv2 loaded from:', os.path.dirname(cv2.__file__))"
    python3 -c "import cv2.dnn; assert hasattr(cv2.dnn, 'DictValue'); print('cv2.dnn OK')"

    # From imaginaire's own scripts/requirements.txt, merged in with the
    # following deliberate exclusions/changes vs. the original list:
    #   - opencv-python / opencv-contrib-python: OMITTED. These are non-
    #     headless builds (GUI bindings, need a display) and would reinstall
    #     a second cv2 build on top of the opencv-python-headless fix above,
    #     reintroducing the cv2.dnn.DictValue conflict already resolved.
    #   - scipy==1.3.3: left UNPINNED. This version predates Python 3.8
    #     wheel support and is incompatible with numpy==1.26.4; pinning it
    #     here would likely break the build outright.
    #   - requests==2.25.1: left UNPINNED. wandb/huggingface-hub/mlflow
    #     (already installed above) typically require requests>=2.28;
    #     pinning this old a version risks a resolver conflict.
    pip install --no-cache-dir -c /tmp/constraints.txt \
        cmake \
        pynvml \
        "Pillow>=8.3.2" \
        scipy \
        scikit-image \
        "tqdm==4.35.0" \
        wget \
        cython \
        lmdb \
        av \
        imutils \
        imageio-ffmpeg \
        qimage2ndarray \
        requests \
        "nvidia-ml-py3==7.352.0" \
        pyglet \
        diskcache \
        boto3 \
        awscli-plugin-endpoint \
        awscli \
        rsa \
        lpips \
        clean-fid \
        dlib

    # face-alignment lists opencv-python as a direct dependency, which
    # would reintroduce a second cv2 build. Install with --no-deps and
    # supply its other real requirements by hand (numpy, scikit-image,
    # tqdm already installed above).
    pip install --no-cache-dir --no-deps -c /tmp/constraints.txt face-alignment

    # Pin numpy to the 1.x line already used by the base image's compiled
    # extensions (SimpleITK, ITK, torch, etc.). opencv-python-headless is
    # also listed here as a backstop pin in case any downstream package
    # (e.g. albumentations) tries to touch it again -- the explicit
    # install above is what actually prevents the conflict; this pin just
    # ensures nothing silently bumps the version afterward.
    echo "numpy==1.26.4" > /tmp/constraints.txt
    cat >> /tmp/constraints.txt << 'EOF'
opencv-python-headless==4.9.0.80
nvidia-cublas-cu12==12.8.4.1
nvidia-cuda-cupti-cu12==12.8.90
nvidia-cuda-nvrtc-cu12==12.8.93
nvidia-cuda-runtime-cu12==12.8.90
nvidia-cudnn-cu12==9.10.2.21
nvidia-cufft-cu12==11.3.3.83
nvidia-cufile-cu12==1.13.1.3
nvidia-curand-cu12==10.3.9.90
nvidia-cusolver-cu12==11.7.3.90
nvidia-cusparse-cu12==12.5.8.93
nvidia-cusparselt-cu12==0.7.1
nvidia-nccl-cu12==2.27.5
nvidia-nvjitlink-cu12==12.8.93
nvidia-nvtx-cu12==12.8.90
EOF

    pip install --no-cache-dir -c /tmp/constraints.txt \
        scikit-learn \
        lightning \
        h5py \
        imageio \
        albumentations \
        torchview \
        torchviz \
        "ray[tune]" \
        hydra-core \
        hydra-optuna-sweeper \
        hydra-ray-launcher \
        omegaconf \
        tensorboard \
        mlflow \
        termcolor \
        click \
        torchmetrics[image] \
        wandb

    pip install --no-cache-dir -c /tmp/constraints.txt \
        "tensorflow==2.19.1"

    pip install --no-cache-dir -c /tmp/constraints.txt \
        nnunetv2 \
        SimpleITK \
        antspyx \
        nibabel \
        dicom2nifti \
        pydicom \
        python-gdcm \
        hd-bet \
        dynamic-network-architectures \
        batchgenerators \
        batchgeneratorsv2 \
        acvl-utils \
        connected-components-3d

    pip install --no-cache-dir -c /tmp/constraints.txt \
        einops \
        graphviz \
        tifffile \
        imagecodecs \
        skops \
        timm \
        safetensors \
        huggingface-hub

    pip install --no-cache-dir "numpy==1.26.4"

    echo "Verifying key package versions..."
    python -c "import numpy; print('numpy:', numpy.__version__)" || echo "WARNING: numpy import failed"
    python -c "import torch; print('torch:', torch.__version__, '| CUDA available:', torch.cuda.is_available(), '| supported archs:', torch.cuda.get_arch_list())" || echo "WARNING: torch import failed"
    python -c "import SimpleITK; print('SimpleITK OK')" || echo "WARNING: SimpleITK import failed"
    python -c "import cv2; print('opencv OK:', cv2.__version__)" || echo "WARNING: opencv import failed"
    python -c "import cv2.dnn; assert hasattr(cv2.dnn, 'DictValue'); print('cv2.dnn OK')" || echo "FATAL-CHECK: cv2.dnn missing or broken -- pipeline requires it"
    python -c "import albumentations; print('albumentations OK:', albumentations.__version__)" || echo "WARNING: albumentations import failed"
    python -c "import tensorflow as tf; print('tensorflow:', tf.__version__, '| GPUs visible:', tf.config.list_physical_devices('GPU'))" || echo "NOTE: empty GPU list during build is expected."
    python -c "import onnxruntime; print('onnxruntime OK')" || echo "WARNING: onnxruntime import failed"
    echo "Verification checks complete."
    echo "Installation complete."


%labels
    Author "Yu Lab"
    Version "1.9"
    Description "MONAI toolkit with full set of dependencies for CLASP project."

%help
This is a custom Apptainer container based on the NVIDIA MONAI Toolkit.
Includes lightning, ray[tune], hydra, tensorboard, mlflow, nnU-Net v2,
SimpleITK/antspyx, albumentations, medical imaging utilities, and
imaginaire's five custom CUDA extensions (correlation, channelnorm,
resample2d, bias_act, upfirdn2d) built from local source under
models/UNIT_pix2pixHD.

KNOWN LIMITATION: the CUDA extensions target sm_70/75/80 only — no sm_120
(Blackwell) support yet. Patch each extension's setup.py gencode list
before rebuilding if running on an RTX 50-series GPU.

To build this container, run:
  sudo apptainer build --force comparisons.sif comparisons.def