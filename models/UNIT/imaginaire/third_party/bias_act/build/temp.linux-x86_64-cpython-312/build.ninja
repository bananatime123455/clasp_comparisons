ninja_required_version = 1.3
cxx = /home/theperfectbanana/miniforge3/envs/comparisons/bin/x86_64-conda-linux-gnu-c++
nvcc = /home/theperfectbanana/miniforge3/envs/UNIT/bin/nvcc

cflags = -march=nocona -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -fno-plt -O2 -ffunction-sections -pipe -isystem /home/theperfectbanana/miniforge3/envs/comparisons/include -I/home/theperfectbanana/miniforge3/envs/comparisons/targets/x86_64-linux/include -DNDEBUG -D_FORTIFY_SOURCE=2 -O2 -isystem /home/theperfectbanana/miniforge3/envs/comparisons/include -I/home/theperfectbanana/miniforge3/envs/comparisons/targets/x86_64-linux/include -fPIC -I/home/theperfectbanana/miniforge3/envs/comparisons/lib/python3.12/site-packages/torch/include -I/home/theperfectbanana/miniforge3/envs/comparisons/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -I/home/theperfectbanana/miniforge3/envs/UNIT/include -I/home/theperfectbanana/miniforge3/envs/comparisons/include/python3.12 -c
post_cflags = -Wall -std=c++17 -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=bias_act_cuda
cuda_cflags = -I/home/theperfectbanana/miniforge3/envs/comparisons/lib/python3.12/site-packages/torch/include -I/home/theperfectbanana/miniforge3/envs/comparisons/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -I/home/theperfectbanana/miniforge3/envs/UNIT/include -I/home/theperfectbanana/miniforge3/envs/comparisons/include/python3.12 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -gencode arch=compute_70,code=sm_70 -gencode arch=compute_75,code=sm_75 -Xcompiler -Wall -std=c++17 -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=bias_act_cuda -ccbin /home/theperfectbanana/miniforge3/envs/comparisons/bin/x86_64-conda-linux-gnu-cc
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags







